# Same Supabase project the G2 admin panel already uses — copy these two
# values straight from the G2 repo's .env (VITE_SUPABASE_URL and
# VITE_SUPABASE_PUBLISHABLE_KEY). The publishable/anon key is safe to
# expose client-side by design; access is enforced by Postgres RLS.
NEXT_PUBLIC_SUPABASE_URL="https://fypecyrqallosuiynpov.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Postgres connection string for that same Supabase project — Settings →
# Database → Connection string → URI. Use the "Transaction pooler" (port
# 6543) URI for serverless hosts like Vercel. This one IS sensitive —
# unlike the anon key above, don't share it outside your own env config.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[password]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres"
