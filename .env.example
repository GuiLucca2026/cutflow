# Same Supabase project the G2 admin panel already uses — copy these two
# values straight from the G2 repo's .env (VITE_SUPABASE_URL and
# VITE_SUPABASE_PUBLISHABLE_KEY). The publishable/anon key is safe to
# expose client-side by design; access is enforced by Postgres RLS. No
# direct database connection string is needed — all data access goes
# through Supabase's REST API (PostgREST) via these same two values.
NEXT_PUBLIC_SUPABASE_URL="https://fypecyrqallosuiynpov.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Only needed to run `npm run db:seed` (populates demo data locally).
# RLS only allows writes from authenticated users, so the seed script logs
# in as a real Supabase Auth user before seeding — any real G2 admin login
# works here. Not needed for `npm run dev` / `npm run build`.
SEED_USER_EMAIL="seu@email.com"
SEED_USER_PASSWORD="sua-senha"
